# База API. В деве оставьте /api — Vite проксирует на бэкенд.
# VITE_API_BASE=/api

# Куда Vite проксирует /api в режиме разработки.
# VITE_API_PROXY=http://127.0.0.1:8000

# Какой пользователь подставляется при открытии вне Telegram
# (работает только если API запущен с APP_ENV=dev).
# VITE_DEV_USER_ID=1
